{
  "name": "application-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "launch": "node scripts/launch.mjs",
    "dev": "next dev -H 127.0.0.1 -p 3939",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3939",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run check:pipeline && npm run check:adapters",
    "check:pipeline": "tsx scripts/check-pipeline.mts",
    "check:adapters": "tsx scripts/check-adapters.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@prisma/client": "^6.19.3",
    "googleapis": "^176.0.0",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
