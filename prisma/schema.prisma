// Internship Applications Tracker.
// SQLite has no enum type, so every enum in the PRD is a String here and the
// allowed values are named in a comment above the field.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One row only. The CHECK (id = 1) rule is added by hand in the migration.
model UserSettings {
  id                 Int       @id @default(1)
  /// OPENROUTER | ANTHROPIC | GEMINI
  llmProvider        String?   @map("llm_provider")
  llmApiKeyEncrypted String?   @map("llm_api_key_encrypted")
  readFromDate       DateTime? @map("read_from_date")
  /// The GROUPING_VERSION the applications were last rebuilt with. A value
  /// behind the constant makes the next sync rebuild once (LOOP Invariant 1).
  groupingVersion    Int?      @map("grouping_version")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("user_settings")
}

model GmailAccount {
  id             Int       @id @default(autoincrement())
  emailAddress   String    @unique @map("email_address")
  displayName    String?   @map("display_name")
  refreshToken   String    @map("refresh_token")
  accessToken    String?   @map("access_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  lastSyncAt     DateTime? @map("last_sync_at")
  /// False means the refresh token was rejected. Drives the Reconnect screen.
  isActive       Boolean   @default(true) @map("is_active")

  messages EmailMessage[]

  @@map("gmail_accounts")
}

model EmailMessage {
  id               Int      @id @default(autoincrement())
  gmailAccountId   Int      @map("gmail_account_id")
  gmailMessageId   String   @map("gmail_message_id")
  rfc822MessageId  String?  @map("rfc822_message_id")
  threadId         String?  @map("thread_id")
  senderName       String?  @map("sender_name")
  senderEmail      String?  @map("sender_email")
  senderDomain     String?  @map("sender_domain")
  subject          String?
  snippet          String?
  bodyText         String?  @map("body_text")
  /// JSON array of Gmail label ids.
  labels           String?
  receivedAt       DateTime @map("received_at")

  /// PENDING | OK | FAILED | SKIPPED_PREFILTER
  classificationStatus String  @default("PENDING") @map("classification_status")
  classifierVersion    Int?    @map("classifier_version")
  llmModel             String? @map("llm_model")
  classificationAttempts Int   @default(0) @map("classification_attempts")
  classificationError  String? @map("classification_error")

  isApplicationRelated Boolean? @map("is_application_related")
  isSignificant        Boolean? @map("is_significant")
  emailTitle           String?  @map("email_title")
  llmClassificationRaw String?  @map("llm_classification_raw")

  account     GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  memberships ApplicationMembership[] @relation("MembershipMessage")
  /// The memberships that sit under this email in some application's drawer.
  parentOf    ApplicationMembership[] @relation("MembershipParent")
  statusHistory ApplicationStatusHistory[]
  correction    ApplicationCorrection?

  @@unique([gmailAccountId, gmailMessageId])
  @@index([threadId])
  @@index([classificationStatus])
  @@index([receivedAt])
  @@map("email_messages")
}

/**
 * Which application an email belongs to (LOOP4 Decision 1).
 *
 * > Belonging is a row of its own, and it is the only truth.
 *
 * This used to be one nullable column on the message, which made it impossible
 * to say that one email is about two applications. An employer running two
 * postings sends mail that covers both, and a single column has to pick one:
 * the code picked by row id and never said it had guessed.
 *
 * Everything on this row is about the pairing rather than about the email,
 * which is why none of it can live on the message:
 *
 *   reason             what made this link, from evidence down to a guess
 *   parent_message_id  the line this email sits under in THIS drawer
 *
 * The parent is the clearest case. `treeIn` works out where an email sits
 * inside one application, so an email in two applications sits under a
 * different line in each, and one column can no more hold that than
 * `application_id` could.
 *
 * `application_id`, `parent_message_id` and `parent_relation` were dropped from
 * `email_messages` rather than kept as a convenience. Keeping them would have
 * left every call site somebody forgot reading a half correct board in silence;
 * dropping them turned each one into a compile error instead.
 */
model ApplicationMembership {
  id            Int @id @default(autoincrement())
  applicationId Int @map("application_id")
  messageId     Int @map("message_id")

  /// NEW | THREAD | REQUISITION | TITLE | HANDOFF | SCORE | FANOUT, and null
  /// only on a row carried over from before this table existed. It is what
  /// Decision 5 reads before writing an alias and what Decision 3 reads before
  /// undoing a link: a link made because two emails quote the same posting
  /// number is evidence, and one made because two rows both scored 0.5 is a
  /// guess, and the two may not be stored as though they were the same thing.
  reason String?

  /// The email whose line in this application's drawer this one is shown
  /// under, or null when it holds a line of its own. A derived fact, worked
  /// out in stage 5, which is the first place the other emails of an
  /// application are visible, and rewritten on every recalculation. Never
  /// authored.
  ///
  /// `is_significant` still says what the model said about the email read on
  /// its own, so the two facts stay apart: this says where the email is shown,
  /// that says whether it records a change of state (LOOP2 3.2 rule 6).
  parentMessageId Int?    @map("parent_message_id")
  /// REPEAT | REMINDER | UPDATE. A label for display only. The nesting is
  /// decided by parent_message_id and does not depend on this. Null exactly
  /// when parent_message_id is null.
  parentRelation  String? @map("parent_relation")

  createdAt DateTime @default(now()) @map("created_at")

  application Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  message     EmailMessage  @relation("MembershipMessage", fields: [messageId], references: [id], onDelete: Cascade)
  parent      EmailMessage? @relation("MembershipParent", fields: [parentMessageId], references: [id], onDelete: SetNull)

  @@unique([applicationId, messageId])
  @@index([messageId])
  @@index([parentMessageId])
  @@map("application_membership")
}

model Application {
  id               Int       @id @default(autoincrement())
  companyName      String    @map("company_name")
  companyNormalized String   @map("company_normalized")
  companyDomain    String?   @map("company_domain")
  roleTitle        String?   @map("role_title")
  dedupeKey        String    @unique @map("dedupe_key")
  /// Summer | Spring | Fall
  season           String?
  year             Int?
  /// ACCEPTED | IN_PROGRESS | APPLIED | REJECTED
  status           String    @default("APPLIED")
  /// ASSESSMENT | RECORDED_INTERVIEW | INTERVIEW | VERIFICATION. Which step an
  /// application in progress is at, and null when it is at none.
  stageDetail      String?   @map("stage_detail")
  /// OFFER_EXTENDED | OFFER_ACCEPTED | OFFER_DECLINED | OFFER_RESCINDED |
  /// REJECTED_BY_EMPLOYER | WITHDRAWN_BY_APPLICANT | POSTING_CANCELLED.
  /// Symmetric with stage_detail: that says which step a live application is
  /// at, this says which ending a finished one reached (LOOP4 Decision 7).
  /// Null when the application has not ended, and null too when it has ended
  /// and no email said how, which is what "Application Closed" is for.
  outcome          String?
  firstEmailAt     DateTime? @map("first_email_at")
  latestEmailAt    DateTime? @map("latest_email_at")
  atsVendor        String?   @map("ats_vendor")
  confidence       Float?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  memberships   ApplicationMembership[]
  statusHistory ApplicationStatusHistory[]

  @@index([companyNormalized])
  @@index([status])
  @@index([latestEmailAt])
  @@index([season, year])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  /// ACCEPTED | IN_PROGRESS | APPLIED | REJECTED
  status        String
  messageId     Int      @map("message_id")
  /// The received_at of the email that produced this status.
  detectedAt    DateTime @map("detected_at")

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([applicationId, messageId, status])
  @@index([applicationId])
  @@map("application_status_history")
}

/**
 * The two corrections made by hand, kept off Application because a rebuild
 * deletes every application row (LOOP Invariant 1).
 *
 * Keyed by the anchor message: the oldest message in the application at the
 * moment the correction was made. Gmail message ids never change, so after a
 * rebuild the correction attaches itself again to whichever row now holds that
 * message. A correction therefore follows its anchor.
 */
model ApplicationCorrection {
  id              Int      @id @default(autoincrement())
  anchorMessageId Int      @unique @map("anchor_message_id")
  isHidden        Boolean  @default(false) @map("is_hidden")
  /// ACCEPTED | IN_PROGRESS | APPLIED | REJECTED. Beats the calculated status.
  statusOverride  String?  @map("status_override")
  /// What the row said when the correction was made. A rebuild compares these
  /// so a correction whose anchor landed somewhere it no longer fits is
  /// reported rather than quietly applied.
  companySnapshot String?  @map("company_snapshot")
  roleSnapshot    String?  @map("role_snapshot")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  message EmailMessage @relation(fields: [anchorMessageId], references: [id], onDelete: Cascade)

  @@map("application_corrections")
}

model CompanyAlias {
  id                  Int      @id @default(autoincrement())
  aliasNormalized     String   @unique @map("alias_normalized")
  canonicalCompanyName String  @map("canonical_company_name")
  /// Which link claimed these two names are one employer (LOOP4 Decision 5).
  /// NEW | THREAD | REQUISITION | TITLE, and never SCORE, HANDOFF or FANOUT:
  /// an alias is believed by every later message and nothing removes it, so it
  /// may only come from a match somebody could point at. Null on a row written
  /// before this column existed; a rebuild clears the table, so that is a
  /// transient state rather than a permanent one.
  reason              String?
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("company_aliases")
}

model SyncRun {
  id                 Int       @id @default(autoincrement())
  startedAt          DateTime  @default(now()) @map("started_at")
  finishedAt         DateTime? @map("finished_at")
  /// FULL | INCREMENTAL
  mode               String
  messagesDiscovered Int       @default(0) @map("messages_discovered")
  messagesFetched    Int       @default(0) @map("messages_fetched")
  messagesClassified Int       @default(0) @map("messages_classified")
  /// DISCOVERING | FETCHING | CLASSIFYING | TIDYING
  stage              String    @default("DISCOVERING")
  /// How far the stage above has got, and how far it has to go: searches run
  /// while discovering, emails while downloading and reading. The progress
  /// readout divides by these, so a refresh with ten new emails draws the same
  /// bar as a first run with three hundred.
  stageDone          Int       @default(0) @map("stage_done")
  stageTotal         Int       @default(0) @map("stage_total")
  errors             Int       @default(0)
  errorSummary       String?   @map("error_summary")
  /// Application pairs that look like one application split in two. A report,
  /// not a constraint: the unique rule on dedupe_key can only ever notice an
  /// identical repeat, which the serial pass already prevents (LOOP F5).
  splitSuspects      Int       @default(0) @map("split_suspects")
  /// Applications rebuilt from scratch because GROUPING_VERSION moved on.
  applicationsRebuilt Int      @default(0) @map("applications_rebuilt")
  /// Things worth saying that are not failures: a rebuild, a correction whose
  /// anchor moved somewhere it no longer fits.
  notes              String?
  /// RUNNING | OK | PARTIAL | FAILED
  status             String    @default("RUNNING")

  usage LlmUsage[]

  @@map("sync_runs")
}

model LlmUsage {
  id           Int      @id @default(autoincrement())
  syncRunId    Int?     @map("sync_run_id")
  createdAt    DateTime @default(now()) @map("created_at")
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  costUsd      Float    @map("cost_usd")

  syncRun SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@map("llm_usage")
}
